{
  // strict: true — весь набор проверок null/undefined, неявного any и т.д.
  // Без этого интерфейсы (основа DI и SOLID, раздел 6 архитектуры) не дают
  // компилятору реальных гарантий — они превращаются в необязательные подсказки.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // tsc проверяет типы по всему проекту сразу и сам знает, что, скажем, ErrorReporter —
    // интерфейс, а не значение. Но tsx и vitest транспилируют/исполняют файлы ПО ОТДЕЛЬНОСТИ
    // через esbuild, который типов не читает вообще — только синтаксис. export { X } from '...'
    // без слова type esbuild считает реэкспортом значения; если X — интерфейс (в рантайме не
    // существует), реэкспорт упадёт при запуске ("does not provide an export named…"), хотя
    // npm run typecheck при этом будет зелёным. verbatimModuleSyntax обязывает писать
    // export type/import type явно везде, где экспортируется только тип, — и превращает эту
    // ошибку в ошибку tsc, а не в сюрприз на исполнении.
    "verbatimModuleSyntax": true,

    // NodeNext резолвит модули как настоящий Node ESM: в относительном импорте
    // ожидается расширение файла, который будет исполняться (.js), даже если
    // исходник — .ts. allowImportingTsExtensions разрешает писать честное .ts.
    // TypeScript допускает это только когда сам не эмитит .js (noEmit ниже) —
    // у нас так и есть: tsc используется только как чекер (ADR 001), а
    // исполняет код tsx, который сам разбирается с расширениями.
    "allowImportingTsExtensions": true,
    "noEmit": true,

    // strict НЕ включает эту проверку. Без неё array[i] типизируется как T — компилятор
    // верит, что индекс попал в границы, хотя длину массива он не отслеживает. Индекс,
    // пришедший из другого массива (как this.sinks[index] в composite-error-reporter.ts,
    // где index — индекс из results, не из самого sinks), или просто опечатка в границе
    // цикла — и получаем undefined там, где тип обещал T, без единой ошибки компиляции.
    // Для торгового кода это не абстрактный риск: следующая по времени свеча
    // (candles[i + 1]) или последняя открытая позиция (positions[positions.length - 1])
    // на пустом/укороченном массиве точно так же дают undefined, а не T.
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*", "tests/**/*"]
}
